# Reversa runs with none of these set. Each one turns a simulated path into a
# real one, and the /api/system route states which mode everything is in.

# Razorpay test mode. rzp_live_ keys are REJECTED at startup - everything here
# assumes test mode, and a live key would let a demo dunning run fire real
# payment links at real people.
# REVERSA_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# REVERSA_RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# REVERSA_RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# Anthropic. Without it the policy compiler and incident investigator fall back
# to deterministic implementations - real ones, not stubs.
# REVERSA_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Signs session tokens. Generated per process when unset, which means every
# restart invalidates live sessions - fine on a laptop, wrong for more than one
# replica.
# REVERSA_SESSION_SECRET=change-me-to-something-long-and-random

# Grants the operator role, which carries the execute scope and can move money
# in Razorpay test mode. Leave unset and only guest sessions are possible.
REVERSA_DEMO_ACCESS_CODE=reversa-operator
